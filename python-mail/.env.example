# Copy to python-mail/.env and keep it private.
GMAIL_ADDRESS=your.dm.events@gmail.com
# Google App Password (not your normal Google account password)
GMAIL_APP_PASSWORD=replace-with-gmail-app-password
GMAIL_SENDER_NAME="DM Events"
# Must match PYTHON_MAIL_SECRET in the Next.js .env
PYTHON_MAIL_SECRET=replace-with-a-long-cryptographically-random-32-plus-character-secret
PYTHON_MAIL_HOST=127.0.0.1
PYTHON_MAIL_PORT=8765
