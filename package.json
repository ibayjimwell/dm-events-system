    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "resend": "^6.0.0",
    "sharp": "^0.34.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
