# Supabase Project Settings > Database > Connection string (transaction pooler for runtime)
DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Use direct/session pooler for migrations / pg_dump, NOT transaction pooler
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# never prefix secrets NEXT_PUBLIC_
APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_DAYS=7
# Password recovery and email verification use the separate Python Gmail SMTP service below.
EMAIL_VERIFICATION_REQUIRED=false
# set true when verified email sending configured for public production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional automated encrypted offsite backups (AWS S3 or compatible, with pg_dump installed)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY= # 64 hex chars, random AES-256 key
BACKUP_CRON_SECRET=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Gmail SMTP is handled by the separate Python service (NOT by Next.js).
# Local Python service: http://127.0.0.1:8765
PYTHON_MAIL_URL=http://127.0.0.1:8765
# Shared with Python's PYTHON_MAIL_SECRET: at least 32 random characters.
PYTHON_MAIL_SECRET=

# httpSMS API key from https://httpsms.com/settings (account API key, not phone-only key).
# Keep the Android httpSMS app running with an active SIM/mobile plan.
HTTPSMS_API_KEY=
# Sender Android SIM number in E.164 format: +639xxxxxxxxx
HTTPSMS_FROM=

# Secret protecting /api/cron/notifications; 32+ random characters.
NOTIFICATIONS_CRON_SECRET=
